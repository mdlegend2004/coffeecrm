DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/brewco
OPENAI_API_KEY=your_openai_key_here
# URL of the separate channel service. Leave EMPTY to use the built-in simulator
# (single-service mode — what the Render deploy uses).
CHANNEL_SERVICE_URL=http://localhost:8001
CRM_SERVICE_URL=http://localhost:8000

# Optional: password-protect the whole site (leave empty for local dev)
APP_USERNAME=admin
APP_PASSWORD=
# Optional: shared secret with the channel service (must match channel-service/.env)
CALLBACK_SECRET=
